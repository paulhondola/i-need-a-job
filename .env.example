# Required for sending email (sends from this Gmail address to itself via smtp.gmail.com:465)
SMTP_USER=you@gmail.com
# Gmail App Password (requires Google 2-Step Verification; do not use your account password)
SMTP_PASS=xxxx xxxx xxxx xxxx

# OpenAI-compatible API key for LLM tiering (optional; falls back to regex-only if unset)
LLM_API_KEY=gsk_...

# Optional LLM provider overrides (defaults shown; endpoint must support JSON mode)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
